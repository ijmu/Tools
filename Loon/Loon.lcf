[General]
# IP 模式: ipv4-only / dual / ipv4-preferred / ipv6-preferred
ip-mode = v4-only
# DNS 服务，system 表示系统自带 DNS 服务器
dns-server = 223.5.5.5,119.29.29.29
allow-wifi-access = true
wifi-access-http-port = 7222
wifi-access-socks5-port = 7221
# 节点延迟测试
proxy-test-url = http://1.1.1.1/generate_204
# 互联网联通性测试
internet-test-url = http://connectivitycheck.platform.hicloud.com/generate_204
# 策略切换时关闭连接
disconnect-on-policy-change = true
# 默认节点超时时间（秒）
test-timeout = 5
# 域名拦截行为
domain-reject-mode = DNS
# DNS 拒绝行为
dns-reject-mode = LoopbackIP
# SNI 辅助规则匹配
sni-sniffing = true
# UDP 回落策略
udp-fallback-mode = REJECT
# 网络接口
interface-mode = auto
# 自定义 GeoIP 数据库
geoip-url = https://raw.githubusercontent.com/Loyalsoldier/geoip/release/Country.mmdb
# 自定义 ASN 数据库
ipasn-url = https://raw.githubusercontent.com/Loyalsoldier/geoip/release/GeoLite2-ASN.mmdb
# Always Real IP Hosts
real-ip = *.lan,*.direct,*.cmpassport.com,id6.me,open.e.189.cn,mdn.open.wo.cn,opencloud.wostore.cn,auth.wosms.cn,*.10099.com.cn,*.msftconnecttest.com,*.msftncsi.com,lancache.steamcontent.com
# 资源解析器
resource-parser = https://github.com/sub-store-org/Sub-Store/releases/latest/download/sub-store-parser.loon.min.js
# 图标库地址
#https://raw.githubusercontent.com/lige47/lige_icon/main/ligeicon.json

[Proxy]

[Remote Proxy]
机场1 = 地址1,parser-enabled = true,udp=true,block-quic=default,fast-open=default,vmess-aead=true,skip-cert-verify=true,enabled=true,flexible-sni=false
机场2 = 地址2,parser-enabled = true,udp=true,block-quic=default,fast-open=default,vmess-aead=true,skip-cert-verify=true,enabled=true,flexible-sni=false

[Remote Filter]
Subscribe = NameRegex, FilterKey = "^((?!(套餐|订阅|到期|客户端|支持)).)*$"
Hong Kong = NameRegex, FilterKey = "🇭🇰|香港"
United States = NameRegex, FilterKey = "🇺🇸|美国"
Taiwan = NameRegex, FilterKey = "🇨🇳|台湾"
Japan = NameRegex, FilterKey = "🇯🇵|日本"
Singapore = NameRegex, FilterKey = "🇸🇬|新加坡"
United Kingdom = NameRegex, FilterKey = "🇬🇧|英国"
Germany = NameRegex, FilterKey = "🇩🇪|德国"
Philippine = NameRegex, FilterKey = "🇵🇭|菲律宾"
Turkey = NameRegex, FilterKey = "🇹🇷|土耳其"
Nigeria = NameRegex, FilterKey = "🇳🇬|尼日利亚"

[Proxy Group]
Sub = url-test,Subscribe,interval = 60,tolerance = 50,img-url = https://raw.githubusercontent.com/lige47/QuanX-icon-rule/main/icon/02ProxySoftLogo/Loon.png
Auto = select,Sub,HK,TW,JP,SG,UK,DE,PH,TR,NG,url = http://1.1.1.1/generate_204,img-url = https://raw.githubusercontent.com/lige47/QuanX-icon-rule/main/icon/05icon/rocket(1).png
Apple = select,Auto,Sub,DIRECT,HK,US,img-url = https://raw.githubusercontent.com/lige47/QuanX-icon-rule/main/icon/03CNSoft/apple.png
AI = select,Auto,US,JP,SG,url = http://1.1.1.1/generate_204,img-url = https://raw.githubusercontent.com/lige47/QuanX-icon-rule/main/icon/04ProxySoft/chatGPT-green.png
Crypto = select,Auto,TW,JP,SG,url = http://1.1.1.1/generate_204,img-url = https://raw.githubusercontent.com/lige47/QuanX-icon-rule/main/icon/04ProxySoft/Bitcoin.png
Google = select,Auto,HK,US,TR,NG,img-url = https://raw.githubusercontent.com/lige47/QuanX-icon-rule/main/icon/04ProxySoft/google(1).png
Twitter = select,Auto,HK,US,TR,NG,url = http://1.1.1.1/generate_204,img-url = https://raw.githubusercontent.com/lige47/QuanX-icon-rule/main/icon/04ProxySoft/twitter.png
Telegram = select,Auto,HK,US,TR,NG,img-url = https://raw.githubusercontent.com/lige47/QuanX-icon-rule/main/icon/04ProxySoft/telegram(1).png
Tiktok = select,Auto,US,TW,JP,url = http://1.1.1.1/generate_204,img-url = https://raw.githubusercontent.com/lige47/QuanX-icon-rule/main/icon/04ProxySoft/tiktok.png
MP4 = select,Auto,HK,US,TW,JP,img-url = https://raw.githubusercontent.com/lige47/QuanX-icon-rule/main/icon/03CNSoft/fileball.png
HK = url-test,Hong Kong,url = http://1.1.1.1/generate_204,interval = 60,tolerance = 50,img-url = https://raw.githubusercontent.com/lige47/QuanX-icon-rule/main/icon/01Country/Hongkong(2).png
US = url-test,United States,url = http://1.1.1.1/generate_204,interval = 60,tolerance = 50,img-url = https://raw.githubusercontent.com/lige47/QuanX-icon-rule/main/icon/01Country/US(1).png
TW = url-test,Taiwan,url = http://1.1.1.1/generate_204,interval = 60,tolerance = 50,img-url = https://raw.githubusercontent.com/lige47/QuanX-icon-rule/main/icon/01Country/taiwan(2).png
JP = url-test,Japan,url = http://1.1.1.1/generate_204,interval = 60,tolerance = 50,img-url = https://raw.githubusercontent.com/lige47/QuanX-icon-rule/main/icon/01Country/Japan(1).png
SG = url-test,Singapore,url = http://1.1.1.1/generate_204,interval = 60,tolerance = 50,img-url = https://raw.githubusercontent.com/lige47/QuanX-icon-rule/main/icon/01Country/singapore(2).png
UK = url-test,United Kingdom,url = http://1.1.1.1/generate_204,interval = 60,tolerance = 50,img-url = https://raw.githubusercontent.com/lige47/QuanX-icon-rule/main/icon/01Country/UnitedKingdom.png
DE = url-test,Germany,url = http://1.1.1.1/generate_204,interval = 60,tolerance = 50,img-url = https://raw.githubusercontent.com/lige47/QuanX-icon-rule/main/icon/01Country/Germany.png
PH = url-test,Philippine,url = http://1.1.1.1/generate_204,interval = 60,tolerance = 50,img-url = https://raw.githubusercontent.com/lige47/QuanX-icon-rule/main/icon/01Country/RepublicofthePhilippines(1).png
TR = url-test,Turkey,url = http://1.1.1.1/generate_204,interval = 60,tolerance = 50,img-url = https://raw.githubusercontent.com/lige47/QuanX-icon-rule/main/icon/01Country/Turkey.png
NG = url-test,Nigeria,url = http://1.1.1.1/generate_204,interval = 60,tolerance = 50,img-url = https://raw.githubusercontent.com/lige47/QuanX-icon-rule/main/icon/01Country/FederalRepublicofNigeria.png

[Proxy Chain]

[Rule]
DOMAIN-SUFFIX,gjfzpt.cn,REJECT
DOMAIN-KEYWORD,96110,REJECT
FINAL,Auto

[Remote Rule]
https://github.com/Repcz/Tool/raw/X/Loon/Rules/Porn.list, policy=MP4, tag=Porn, enabled=true
https://github.com/QuixoticHeart/rule-set/raw/refs/heads/ruleset/loon/crypto.list, policy=Crypto, tag=crypto, enabled=true
https://rule.kelee.one/Loon/Telegram.lsr, policy=Telegram, tag=Telegram, enabled=true
https://rule.kelee.one/Loon/Twitter.lsr, policy=Twitter, tag=Twitter, enabled=true
https://rule.kelee.one/Loon/TikTok.lsr, policy=Tiktok, tag=TikTok, enabled=true
https://rule.kelee.one/Loon/YouTube.lsr, policy=Google, tag=YouTube, enabled=true
https://rule.kelee.one/Loon/Google.lsr, policy=Google, tag=Google, enabled=true
https://kelee.one/Tool/Loon/Lsr/AI.lsr, policy=AI, tag=AI, enabled=true
https://github.com/QuixoticHeart/rule-set/raw/refs/heads/ruleset/loon/apns.list, policy=Apple, tag=apns, enabled=true
https://github.com/Repcz/Tool/raw/X/Loon/Rules/Lan.list, policy=DIRECT, tag=LAN, enabled=true
https://raw.githubusercontent.com/missuo/ASN-China/main/ASN.China.list, policy=DIRECT, tag=ChinaASN, enabled=true

[Host]
# App Store 下载请求解析 金山CDN
iosapps.itunes.apple.com = iosapps.itunes.apple.com.download.ks-cdn.com

[Rewrite]

[Script]

[Remote Script]
https://github.com/fmz200/wool_scripts/raw/main/Loon/script/tools.scripts, tag=脚本工具合集, enabled=true
https://github.com/fmz200/wool_scripts/raw/main/Loon/script/tasks.scripts, tag=定时任务合集, enabled=true

[Plugin]
https://kelee.one/Tool/Loon/Lpx/Spotify_remove_ads.lpx, tag=Spotify, enabled=false
https://kelee.one/Tool/Loon/Lpx/YouTube_remove_ads.lpx, tag=YouTube, enabled=true
https://kelee.one/Tool/Loon/Lpx/BoxJs.lpx, policy=Auto, tag=BoxJs, enabled=true
https://kelee.one/Tool/Loon/Lpx/BlockAdvertisers.lpx, tag=广告平台拦截器, pin=true, enabled=true
https://kelee.one/Tool/Loon/Lpx/Block_HTTPDNS.lpx, tag=HTTPDNS拦截器, pin=true, enabled=true

[MITM]
skip-server-cert-verify = false
